# Built application files
*.apk
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
release/

# Gradle files
.gradle/
build/
*/build/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
*.iml
.idea/workspace.xml
.idea/tasks.xml
.idea/gradle.xml
.idea/assetWizardSettings.xml
.idea/dictionaries
.idea/libraries
.idea/jarRepositories.xml
.idea/caches
.idea/modules.xml
.idea/.name
.idea/compiler.xml
.idea/misc.xml
.idea/deploymentTargetSelector.xml
.idea/vcs.xml
.idea/inspectionProfiles/

# Keystore files
*.jks
*.keystore

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/

# Google Services (e.g. APIs or Firebase)
google-services.json

# Freeline
freeline.py
freeline/
freeline_project_description.json

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
fastlane/readme.md

# Version control
vcs.xml

# lint
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/
lint-results*.xml

# Android Profiling
*.hprof

# macOS
.DS_Store

# Screenshots directory (local only)
screenshots/
*.png
!app/src/main/res/**/*.png

# Resource files that should be in res/
*.xml
!app/src/main/res/**/*.xml
!app/src/main/AndroidManifest.xml
!build.gradle.kts
!settings.gradle.kts
!gradle.properties

# Resource files in root (should be in app/src/main/res/values/)
/drawables.xml
/dimens.xml
/arrays.xml
/bools.xml
/integers.xml
/plurals.xml

# Decompiled source (keep original APK only)
*_decompiled/

# Temporary files
*.tmp
*.bak
*.swp
*~.nib
.claude/
